flowchart TD
    subgraph StepA ["STAGE 1: Frame Initialization & Substep Slicing"]
        Start(["Frame Physics Start (dt ≤ 0.05s)"]) --> SpeedCheck["1. Calculate Velocity: v = sqrt(vx² + vy²)"]
        SpeedCheck --> StepCalc["2. Compute Substeps: 1 + (v * dt / (0.5 * radius))
Clamp: 1 ≤ steps ≤ 6 (sdt = dt / steps)"]
    end

    subgraph StepB ["STAGE 2: Substep Motion & Boundary Collision"]
        LoopStart["3. Advance Position:
puck.x += vx * sdt
puck.y += vy * sdt"] --> PadCol["4. Collide With Paddles 1 & 2
• Normal Impulse: j = -(1 + e) * vn
• Tangential Friction -> Imparts Spin
• Flick Boost: +0.35 * paddle_speed"]
        PadCol --> WallCol{"5. Boundary Check"}
    end

    subgraph StepC ["STAGE 3: Event Resolution & Flight Curvature"]
        WallCol -- "Goal Slot" --> GoalScore["Goal Scored!
• Increment Score
• Trigger 14px Shake
• Reset (3s Timer)"]
        WallCol -- "Solid Wall" --> WallBounce["Wall Cushion Bounce
• Invert Normal Velocity
• Emit Impact Sparks & SFX"]
        WallCol -- "Open Rink" --> SpinEffect["6. Magnus Effect
Curve velocity perpendicular
to flight: curve = spin * 0.0006"]
        WallBounce --> SpinEffect
        GoalScore --> EndCheck{"More Substeps?"}
        SpinEffect --> EndCheck
    end

    StepCalc --> LoopStart
    EndCheck -- "Yes (Next Step)" --> LoopStart
    EndCheck -- "No (Complete)" --> Done(["Frame Physics Complete (Zero Tunneling!)"])

